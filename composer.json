{
    "name": "appradar/agent",
    "description": "Framework-aware application agent for AppRadar. Laravel support is included first.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/console": "^12.0",
        "illuminate/contracts": "^12.0",
        "illuminate/database": "^12.0",
        "illuminate/http": "^12.0",
        "illuminate/queue": "^12.0",
        "illuminate/routing": "^12.0",
        "illuminate/support": "^12.0",
        "symfony/process": "^7.2"
    },
    "autoload": {
        "psr-4": {
            "AppRadar\\Agent\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AppRadar\\Agent\\Laravel\\AppRadarServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
