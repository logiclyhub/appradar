{
    "name": "appradar/agent",
    "description": "Framework-aware application agent for AppRadar. Laravel and plain PHP adapters included.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/console": "^12.0",
        "illuminate/contracts": "^12.0",
        "illuminate/database": "^12.0",
        "illuminate/http": "^12.0",
        "illuminate/queue": "^12.0",
        "illuminate/routing": "^12.0",
        "illuminate/support": "^12.0",
        "symfony/process": "^7.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "suggest": {
        "ext-redis": "Required for plain PHP Redis checks when predis is not installed.",
        "predis/predis": "Alternative Redis client for plain PHP Redis checks."
    },
    "autoload": {
        "psr-4": {
            "AppRadar\\Agent\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AppRadar\\Agent\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "AppRadar\\Agent\\Laravel\\AppRadarServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
